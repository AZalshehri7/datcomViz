*  Coverage deck for the Rev 3/11 (2011 revision) inputs.
*
*  Built on the for005.dat airframe, stretched to carry everything that exists
*  in 3/11 and not in 5/97, plus the mistakes the two releases report
*  differently. Written for the checks, not for the aerodynamics — nine fin
*  sets, a cambered body and two co-located tails on one vehicle is not a sane
*  missile. Load it under both target releases and compare the Messages panel;
*  the two should disagree in specific, documented ways.
*
*  CASE 1  clean 3/11 inputs: NVOR, PHIPRO, fin sets 5-9, DELTA5, co-located
*          sets 3 and 4. Every one of these is unknown to 5/97.
*  CASE 2  NVOR out of range, and NVOR on the aftmost set where it does nothing.
*  CASE 3  cambered body (Z) run at non-zero PHI, which 3/11 forbids.
*  CASE 4  $TRIM with NINCR (3/11 only) and ASYM (deleted in 8/08).
*  CASE 5  BETA and PHI in one case — ignored on 5/97, fatal from 7/07.
*
*  Each case resets what the one before it broke, so the faults do not carry
*  forward through SAVE. Case 5 is last because BETA cannot be un-set without
*  deleting $FLTCON outright.
*
CASEID 1  3/11 inputs that are legal on 3/11 and unknown on 5/97
DIM IN
 $FLTCON NALPHA=8.,NMACH=1.,MACH=2.36,REN=3000000.,
         ALPHA=0.,4.,8.,12.,
         ALPHA(5)=16.,20.,24.,28.,$
 $REFQ XCG=24.,$
 $AXIBOD LNOSE=11.25,DNOSE=3.75,LCENTR=36.75,DCENTR=3.75,
         LAFT=4.5,DAFT=3.,DEXIT=2.,$
*  NVOR: 3/11 sheds up to 20 vortices per fin. Worth setting on the forward
*  sets only — vortices act on fins downstream of them, so the aftmost set
*  has nothing to shed into.
 $FINSET1 XLE=15.42,NPANEL=2.,PHIF=90.,270.,SWEEP=0.,STA=1.,
          CHORD=6.96,0.,SSPAN=1.875,5.355,NVOR=12.,
          ZUPPER=2*0.02238,LMAXU=0.238,0.238,
          LFLATU=0.524,0.524,LER=2*0.015,$
 $FINSET2 XLE=24.0,NPANEL=4.,PHIF=0.,90.,180.,270.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,4.0,CHORD=3.0,1.5,NVOR=4.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
*  Sets 3 and 4 sit at the same station with different planforms. 5/97 calls
*  that overlap and an input error; 3/11 permits it deliberately and only
*  loses the vortex tracking between them.
 $FINSET3 XLE=28.0,NPANEL=2.,PHIF=0.,180.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,4.5,CHORD=2.5,1.25,NVOR=3.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
 $FINSET4 XLE=28.0,NPANEL=2.,PHIF=90.,270.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,3.0,CHORD=2.5,1.25,NVOR=3.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
*  Sets 5 to 9 exist only from 8/08 onward.
 $FINSET5 XLE=32.0,NPANEL=2.,PHIF=45.,225.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,2.8,CHORD=2.0,1.0,NVOR=2.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
 $FINSET6 XLE=35.0,NPANEL=2.,PHIF=135.,315.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,2.8,CHORD=2.0,1.0,NVOR=2.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
 $FINSET7 XLE=38.0,NPANEL=2.,PHIF=0.,180.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,2.6,CHORD=1.8,0.9,NVOR=2.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
 $FINSET8 XLE=41.0,NPANEL=2.,PHIF=90.,270.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,2.6,CHORD=1.8,0.9,NVOR=2.,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
 $FINSET9 XLE=44.0,NPANEL=4.,PHIF=45.,135.,225.,315.,LER=2*0.015,
          SWEEP=0.,STA=1.,SSPAN=1.875,2.4,CHORD=1.4,0.7,
          ZUPPER=2*0.02238,LMAXU=2*0.288,LFLATU=2*0.428,$
*  DELTA5 deflects an all-moveable panel on a set past XHINGE's array size,
*  which stayed at 4 while DELTAn went to 9.
 $DEFLCT DELTA1=5.,-5.,DELTA5=3.,-3.,XHINGE=17.,26.,29.,29.,SKEW=4*0.,$
*  PHIPRO arrived in 8/08: one angle per protuberance, sets in order.
 $PROTUB NPROT=2.,PTYPE=VCYL,BLOCK,XPROT=20.,30.,NLOC=3.,2.,
         LPROT=1.,2.,WPROT=0.5,1.,HPROT=0.4,0.6,OPROT=0.,0.,
         PHIPRO=0.,120.,240.,90.,270.,$
DAMP
SAVE
NEXT CASE
CASEID 2  NVOR out of range, and NVOR on the aftmost set
 $FINSET1 NVOR=25.,$
 $FINSET9 NVOR=8.,$
SAVE
NEXT CASE
CASEID 3  cambered body at non-zero roll, which 3/11 forbids
DELETE AXIBOD
 $FINSET1 NVOR=12.,$
 $FINSET9 NVOR=1.,$
 $AXIBOD NX=7.,
         X=0.,3.,8.,11.25,30.,48.,52.5,
         R=0.,0.9,1.65,1.875,1.875,1.875,1.5,
         Z=0.,0.02,0.06,0.10,0.16,0.10,0.05,
         DISCON=4.,6.,
         LNOSE=11.25,DNOSE=3.75,LCENTR=36.75,DCENTR=3.75,
         LAFT=4.5,DAFT=3.,DEXIT=2.,$
 $FLTCON PHI=45.,$
SAVE
NEXT CASE
CASEID 4  TRIM with NINCR (3/11 only) and ASYM (deleted in 8/08)
DELETE AXIBOD
 $AXIBOD LNOSE=11.25,DNOSE=3.75,LCENTR=36.75,DCENTR=3.75,
         LAFT=4.5,DAFT=3.,DEXIT=2.,$
 $FLTCON PHI=0.,$
 $TRIM SET=2.,PANL1=.TRUE.,PANL3=.TRUE.,
       DELMIN=-25.,DELMAX=25.,NINCR=20.,ASYM=8*.FALSE.,$
PRINT AERO TRIM
SAVE
NEXT CASE
CASEID 5  BETA with PHI — ignored on 5/97, fatal from 7/07 onward
DELETE TRIM
 $FLTCON BETA=4.,PHI=30.,$
NEXT CASE
